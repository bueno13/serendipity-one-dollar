# Copy to .env.local and fill in. Never commit .env.local.

# Required for Muse Ember AI (through OpenRouter).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Public URL used for QR code + OpenRouter HTTP-Referer.
# In dev: http://localhost:3000  |  Deployed: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (shared multi-user persistence).
# If all Supabase vars are unset, the app runs in clearly labeled local mode
# (data/store.json on this device) and demo seed/reset are allowed locally.
# Create a project at https://supabase.com, run supabase/schema.sql, then fill these in.
#
# New Supabase keys (recommended):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # safe for the browser (public)
SUPABASE_SECRET_KEY=                    # SERVER-ONLY — never prefix with NEXT_PUBLIC_, never commit
#
# Legacy names still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        # same as publishable key
# SUPABASE_SERVICE_ROLE_KEY=            # same as secret key (server-only)
#
# The server prefers SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY
# (bypasses RLS). The publishable/anon key is only a fallback.
# If Supabase is configured but the DB errors, the API fails loudly
# (500) — it never silently falls back to local storage.

# Operator protection for POST /api/demo (seed + reset).
# Server-only. Required in production; without it those endpoints return 503.
# In local dev (no VERCEL, NODE_ENV!=production) they are allowed with a warning.
# The operator enters this value once in the Live Network page; it is sent as
# the `x-demo-admin-key` header and stored only in sessionStorage for the tab.
DEMO_ADMIN_KEY=
